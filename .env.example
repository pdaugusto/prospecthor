# ============================================================
# .env.example — Variáveis de ambiente do Prospector Bot
# ============================================================
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env
#
# ATENÇÃO: Nunca versionar ou expor o arquivo .env contendo chaves reais.
# ============================================================


# ------------------------------------------------------------
# 1. GOOGLE MAPS / PLACES API (OPCIONAL)
# ------------------------------------------------------------
# Chave da API do Google Places para busca oficial rápida
# Obtenha em: https://console.cloud.google.com/apis/credentials
# Deixe em branco se desejar usar apenas o Playwright (scraping)
GOOGLE_MAPS_API_KEY=sua_key_aqui


# ------------------------------------------------------------
# 2. CONFIGURAÇÕES DO DASHBOARD
# ------------------------------------------------------------
# Nome de usuário para acesso à tela de login do site
DASHBOARD_USER=admin

# Senha de segurança para login no painel
DASHBOARD_PASS=sua_senha_aqui

# Porta padrão de escuta do servidor web Flask
DASHBOARD_PORT=5000

# Chave secreta de criptografia das sessões de cookies do Flask
DASHBOARD_SECRET_KEY=sua_chave_secreta


# ------------------------------------------------------------
# 3. PARÂMETROS DO ROBÔ DE BUSCA
# ------------------------------------------------------------
# String de conexão PostgreSQL (Supabase ou outro provider)
# Formato: postgresql://user:password@host:port/dbname
DATABASE_URL=sua_string_do_supabase

# Caminho padrão de leitura e gravação do banco de dados SQLite (uso local legado)
DATABASE_PATH=data/leads.db


# Diretório padrão para gravação das planilhas exportadas
EXPORT_DIR=data/exports/

# Limite máximo de resultados retornados por busca individual no Google Maps
MAX_RESULTS_PER_SEARCH=100

# Tempo de atraso (delay) entre requisições externas para evitar bloqueio de IP
DELAY_BETWEEN_REQUESTS=3

# Localizações padrão fallback se o scheduler rodar sem configurações dinâmicas
SEARCH_CITY=Porto Alegre
SEARCH_STATE=RS

# Rodar navegador em modo headless (true/false)
PLAYWRIGHT_HEADLESS=true

# Instagram no pipeline: false = mais leads/dia (score já vem no save sem site)
# true = enriquece Instagram (mais lento, mais 429)
SKIP_INSTAGRAM=true

# Timeout máximo das operações de navegação em milissegundos
PLAYWRIGHT_TIMEOUT_MS=30000


# ------------------------------------------------------------
# 4. CRONOGRAMA DE BUSCA DIÁRIA (FORMATO 24h)
# ------------------------------------------------------------
# Horários e listas de nichos (separados por vírgula) para as varreduras:

# Manhã — Alimentação
SCHEDULE_MORNING=08:00
SCHEDULE_MORNING_NICHES=restaurante,bar,pizzaria

# Meio-dia — Beleza/Estética
SCHEDULE_MIDDAY=10:00
SCHEDULE_MIDDAY_NICHES=salão,barbearia,estética

# Tarde — Saúde
SCHEDULE_AFTERNOON=14:00
SCHEDULE_AFTERNOON_NICHES=clínica,dentista,psicólogo

# Fim de Tarde — Comércio/Negócios
SCHEDULE_LATE=16:00
SCHEDULE_LATE_NICHES=loja,pet shop,academia

# Noite — Outros Setores
SCHEDULE_EVENING=20:00
SCHEDULE_EVENING_NICHES=escola,curso,advocacia

# Fechamento — Geração de Relatório Consolidado
SCHEDULE_REPORT=22:00
