# ============================================================
# .env.example — copie para .env e preencha com valores REAIS
# NUNCA commite o arquivo .env
# ============================================================

# --- Google Maps (opcional) ---
GOOGLE_MAPS_API_KEY=

# --- Dashboard / sessão Flask ---
# Usuário principal (Patrão) — no código o principal é sempre "patrao"
DASHBOARD_USER=patrao
# Senha forte do Patrão (obrigatória). Ex: gerador de senha 16+ chars
DASHBOARD_PASS=troque_por_senha_forte_aqui
# Chave de cookie de sessão (obrigatória em produção). Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=troque_por_token_aleatorio_64_hex
DASHBOARD_SECRET_KEY=
DASHBOARD_PORT=5000

# --- Banco (Supabase / Postgres) ---
# Preferir connection string com SSL. Use role com permissões mínimas.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Bot local ---
PLAYWRIGHT_HEADLESS=true
MAX_RESULTS_PER_SEARCH=60
