# ==============================================================
# .gitignore — Prospector Bot
# ==============================================================

# Variáveis de ambiente e segredos
.env
.env.local
.env.*.local
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
ENV/
.python-version
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Banco local
data/leads.db
data/leads.db-wal
data/leads.db-shm
*.sqlite
*.sqlite3
*.db

# Exports gerados
data/exports/*.csv
data/exports/*.xlsx
data/exports/*.json
data/exports/*.jsonl
!data/exports/.gitkeep

# Logs
logs/
*.log
*.log.*
bot.log

# Playwright
.playwright/
playwright-report/
test-results/

# IDEs / SO
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
tmp/
temp/
*.tmp
*.bak
*.orig
